{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.antigravity.videoeditor",
  "productName": "Antigravity Video Editor",
  "copyright": "Copyright © 2026 Antigravity",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/ffmpeg-static/**/*",
    "node_modules/ffprobe-static/**/*",
    "node_modules/fluent-ffmpeg/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**",
    "**/node_modules/ffprobe-static/**"
  ],
  "win": {
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "signtoolOptions": {
      "certificateFile": "build/cert.pfx",
      "certificatePassword": "antigravity123"
    },
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "executableName": "AntigravityVideoEditor"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Antigravity Video Editor",
    "uninstallDisplayName": "Antigravity Video Editor",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico"
  },
  "portable": {
    "artifactName": "Antigravity Video Editor Portable ${version}.${ext}",
    "requestExecutionLevel": "user"
  }
}
